    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "lenis": "^1.3.27"
  }
